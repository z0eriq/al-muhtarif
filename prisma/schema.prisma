generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  DISABLED
}

enum Currency {
  IQD
  USD
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String            @id @default(cuid())
  nameAr      String
  nameEn      String?
  slug        String            @unique
  description String?           @db.Text
  image       String?
  parentId    String?
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  products    ProductCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Product {
  id                String            @id @default(cuid())
  nameAr            String
  nameEn            String?
  slug              String            @unique
  sku               String?           @unique
  descriptionAr     String?           @db.Text
  descriptionEn     String?           @db.Text
  price             Decimal           @db.Decimal(12, 2)
  compareAtPrice    Decimal?          @db.Decimal(12, 2)
  stock             Int               @default(0)
  lowStockThreshold Int               @default(5)
  status            ProductStatus     @default(ACTIVE)
  isFeatured        Boolean           @default(false)
  isNew             Boolean           @default(false)
  tags              String[]
  specifications    Json?
  soldCount         Int               @default(0)
  images            ProductImage[]
  categories        ProductCategory[]
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, isFeatured])
  @@index([createdAt])
  @@index([price])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Customer {
  id            String     @id @default(cuid())
  name          String
  phone         String     @unique
  email         String?
  governorate   String?
  district      String?
  address       String?
  notes         String?    @db.Text
  orders        Order[]
  wishlistItems WishlistItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  customerEmail   String?
  governorate     String
  district        String
  address         String
  notes           String?     @db.Text
  status          OrderStatus @default(NEW)
  paymentMethod   String      @default("COD")
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  currency        Currency    @default(IQD)
  couponCode      String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nameAr    String
  slug      String
  sku       String?
  price     Decimal @db.Decimal(12, 2)
  quantity  Int
  image     String?
  total     Decimal @db.Decimal(12, 2)
}

model WishlistItem {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?
  createdAt  DateTime  @default(now())

  @@index([sessionId])
  @@index([customerId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @default("PERCENT")
  discountValue Decimal   @db.Decimal(12, 2)
  minOrder      Decimal?  @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SiteSettings {
  id               String   @id @default("main")
  storeNameAr      String   @default("المحترف")
  storeNameEn      String   @default("AL MUHTARIF")
  logo             String   @default("/logo.png")
  favicon          String   @default("/logo.png")
  email            String   @default("info@al-muhtraif.com")
  phone            String   @default("+964 7743571934")
  whatsapp         String   @default("+9647743571934")
  address          String   @default("العراق – بابل – الحلة – شارع 40")
  workingHours     String   @default("السبت – الخميس: 9:00 ص – 9:00 م")
  facebookUrl      String?
  instagramUrl     String?
  twitterUrl       String?
  youtubeUrl       String?
  seoTitle         String?
  seoDescription   String?  @db.Text
  googleMapsEmbed  String?  @db.Text
  googleMapsUrl    String?
  currency         Currency @default(IQD)
  currencySymbol   String   @default("د.ع")
  lowStockAlert    Int      @default(5)
  updatedAt        DateTime @updatedAt
}

model HomeContent {
  id                String   @id @default("main")
  heroTitle         String
  heroDescription   String   @db.Text
  heroImage         String?
  heroCtaPrimary    String   @default("تسوق الآن")
  heroCtaSecondary  String   @default("تواصل معنا")
  whyUsItems        Json
  ctaTitle          String
  ctaDescription    String?
  ctaButtonText     String   @default("تصفح المتجر")
  aboutTitle        String?
  aboutContent      String?  @db.Text
  updatedAt         DateTime @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleAr   String
  titleEn   String?
  contentAr String   @db.Text
  contentEn String?  @db.Text
  isPublished Boolean @default(true)
  seoTitle  String?
  seoDescription String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
